{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build_static.js",
  "installCommand": "",
  "outputDirectory": "dist",
  "env": {
    "FANTASY_IQ_LEAGUE_ID": "584856941",
    "FANTASY_IQ_SEASON": "2026"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/FantasyIQ/",
      "permanent": false
    },
    {
      "source": "/FantasyIQ",
      "destination": "/FantasyIQ/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/live-draft",
      "destination": "/api/live_draft"
    },
    {
      "source": "/api/live-draft.json",
      "destination": "/api/live_draft"
    },
    {
      "source": "/api/live-boards",
      "destination": "/api/live_boards"
    },
    {
      "source": "/api/live-boards.json",
      "destination": "/api/live_boards"
    },
    {
      "source": "/api/trade-history",
      "destination": "/api/trade_history"
    },
    {
      "source": "/api/trade-history.json",
      "destination": "/api/trade_history"
    }
  ],
  "headers": [
    {
      "source": "/FantasyIQ/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
