{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run predeploy",
  "installCommand": "",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/login",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/fantasyiq",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fantasyiq/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/live-draft",
      "destination": "/api/live_draft"
    },
    {
      "source": "/api/live-draft.json",
      "destination": "/api/live_draft"
    },
    {
      "source": "/api/draft-bridge",
      "destination": "/api/draft_bridge"
    },
    {
      "source": "/api/draft-bridge.json",
      "destination": "/api/draft_bridge"
    },
    {
      "source": "/api/live-boards",
      "destination": "/api/live_boards"
    },
    {
      "source": "/api/live-boards.json",
      "destination": "/api/live_boards"
    },
    {
      "source": "/api/sos-heatmap",
      "destination": "/api/sos_heatmap"
    },
    {
      "source": "/api/sos-heatmap.json",
      "destination": "/api/sos_heatmap"
    },
    {
      "source": "/api/trade-history",
      "destination": "/api/trade_history"
    },
    {
      "source": "/api/trade-history.json",
      "destination": "/api/trade_history"
    },
    {
      "source": "/api/fantasycalc-market",
      "destination": "/api/fantasycalc_market"
    },
    {
      "source": "/api/fantasycalc-market.json",
      "destination": "/api/fantasycalc_market"
    },
    {
      "source": "/api/fantasycalc-trades",
      "destination": "/api/fantasycalc_trades"
    },
    {
      "source": "/api/fantasycalc-trades.json",
      "destination": "/api/fantasycalc_trades"
    },
    {
      "source": "/api/data-freshness",
      "destination": "/api/data_freshness"
    },
    {
      "source": "/api/data-freshness.json",
      "destination": "/api/data_freshness"
    },
    {
      "source": "/api/cron/daily-data-refresh",
      "destination": "/api/cron_daily_refresh"
    },
    {
      "source": "/api/cron/schedule-heatmap-refresh",
      "destination": "/api/cron_schedule_heatmap"
    },
    {
      "source": "/api/intelligence",
      "destination": "/api/intelligence"
    },
    {
      "source": "/api/intelligence.json",
      "destination": "/api/intelligence"
    },
    {
      "source": "/api/parlay-iq",
      "destination": "/api/parlay_iq"
    },
    {
      "source": "/api/parlay-iq.json",
      "destination": "/api/parlay_iq"
    },
    {
      "source": "/api/setup-validate",
      "destination": "/api/setup_validate"
    },
    {
      "source": "/api/customer-status",
      "destination": "/api/customer_status"
    },
    {
      "source": "/api/customer-login",
      "destination": "/api/customer_login"
    },
    {
      "source": "/api/customer-password",
      "destination": "/api/customer_password"
    },
    {
      "source": "/api/customer-password-reset",
      "destination": "/api/customer_password_reset"
    },
    {
      "source": "/api/customer-session",
      "destination": "/api/customer_session"
    },
    {
      "source": "/api/customer-feedback",
      "destination": "/api/setup_validate?route=customer_feedback"
    },
    {
      "source": "/api/customer-portal",
      "destination": "/api/customer_status?route=customer_portal"
    },
    {
      "source": "/api/add-league-checkout",
      "destination": "/api/add_league_checkout"
    },
    {
      "source": "/api/remove-league",
      "destination": "/api/remove_league"
    },
    {
      "source": "/api/track-event",
      "destination": "/api/setup_validate"
    },
    {
      "source": "/api/admin-customers",
      "destination": "/api/admin_customers"
    },
    {
      "source": "/api/admin-gate",
      "destination": "/api/admin_customers?route=admin_gate"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe_webhook"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-data-refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/schedule-heatmap-refresh",
      "schedule": "30 12 * * 3"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-JB/wYy6rdD/Q32Z6aNCy187gOEjT9bbp1vU/Mwn4h/M=' 'sha256-GD4GYTLo3Xl2NbWlgdWBvkv+aOZhEceshl0xBMn1PAw=' 'sha256-C84zoBPyBzk1LKnvcKs4DI69WelWft4k0g3AJC1POGI=' 'sha256-H1+eZCkkIueSZtcVuF32pZuue49SuXeOGwndZ/z1LV8=' 'sha256-02fK+b3ShJ35jX3Isntml3n6LFhXWVXPb/AB6v+8hiI=' 'sha256-cMO/eVcx7+IGUIyD1y4k3xp9nozk3apSGkTxkBy8+p8=' 'sha256-NhI2eTW1/P3isKQqBx9w0NT+1FmWdGwkoWD436c9eRo=' 'sha256-BajzRktKxIvRpmC6ulKo0pQaXFnQSH6FEOCSCVfV/0I='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; form-action 'self' https://buy.stripe.com; manifest-src 'self'; worker-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/FantasyIQ/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/setup.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/success.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/feedback.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
