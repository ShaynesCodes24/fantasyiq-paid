# Optional SoS Heat Map live-data providers.
# ESPN schedule/team-stat and Sleeper injury data work without keys.
# Add this for Vegas totals/spreads and kicker/team-implied-total context.
THE_ODDS_API_KEY=replace_with_the_odds_api_key
# Keep this to a focused book list so weekly refreshes do not waste paid Odds API credits.
THE_ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm
# Weekly historical snapshots to blend into SoS team-strength baselines. Set 0 to disable, max 18.
FANTASYIQ_SOS_HISTORICAL_WEEKS=4
# Add one of these later for true fantasy-points-allowed-by-position, depth chart,
# and richer injury/personnel feeds if you buy Tank01 or Sportradar access.
TANK01_API_KEY=replace_with_tank01_api_key
SPORTRADAR_API_KEY=replace_with_sportradar_api_key

# Optional private UDK+ signal file generated from your purchased CSV exports.
# Keep raw UDK CSVs and generated signal JSON private unless you have redistribution rights.
FANTASYIQ_UDK_SIGNALS_FILE=private/udk/udk_signals.local.json

# Optional multi-customer registry for one deployment.
# Example:
# FANTASY_IQ_CUSTOMERS_JSON={"demo-manager":{"customerName":"Demo Manager","teamId":5,"teamName":"Sample Team","leagueId":584856941,"season":2026,"status":"configured","accessCode":"customer_code_here","leagueSettings":{"teamCount":12,"scoringType":"ppr","lineupSlots":{"QB":1,"RB":2,"WR":2,"TE":1,"FLEX":1,"SUPERFLEX":0,"DST":1,"K":1,"BE":7,"IR":1},"draftRounds":16,"playoffTeams":6}}}

# Optional multi-league profiles for one customer/deployment.
# Example:
# FANTASY_IQ_LEAGUES_JSON={"home":{"label":"Home League","leagueId":123456789,"teamId":1,"season":2026,"leagueSettings":{"teamCount":12,"scoringType":"ppr","lineupSlots":{"QB":1,"RB":2,"WR":2,"TE":1,"FLEX":1,"SUPERFLEX":0,"DST":1,"K":1,"BE":7,"IR":1},"draftRounds":16,"playoffTeams":6}},"work":{"label":"Work League","leagueId":234567890,"teamId":4,"season":2026,"leagueSettings":{"teamCount":10,"scoringType":"half-ppr","lineupSlots":{"QB":1,"RB":2,"WR":2,"TE":1,"FLEX":2,"SUPERFLEX":0,"DST":1,"K":1,"BE":6,"IR":1},"draftRounds":16,"playoffTeams":4}}}

