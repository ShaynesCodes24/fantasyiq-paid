{
  "manifest_version": 3,
  "name": "MyFantasyIQ Draft Bridge Companion",
  "description": "Beta helper for testing ESPN draft-room access. Manual review remains the source of truth for draft-day picks.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://myfantasyiq.com/*",
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://fantasydraft.espn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://myfantasyiq.com/*",
        "https://myfantasyiq.com/FantasyIQ/*",
        "https://myfantasyiq.com/fantasyiq/*",
        "https://myfantasyiq.com/draft-sync-companion/*"
      ],
      "js": ["dashboard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["espn-draft.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MyFantasyIQ Draft Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
