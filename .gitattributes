# Normalize line endings: Git stores text as LF, checks out per-platform.
# This stops Windows (core.autocrlf) from flagging phantom CRLF changes.
* text=auto eol=lf

# Explicit text files (kept LF in the repo)
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

# Binary files (never touch line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
