{
  "name": "fantasyiq-paid",
  "private": true,
  "scripts": {
    "dev:vercel": "vercel dev",
    "build": "node scripts/build_static.js",
    "format": "prettier --write \".vscode/**/*.json\" \".prettierrc.json\" \"eslint.config.mjs\" \"stylelint.config.mjs\" \"playwright.config.ts\" \"tests/**/*.ts\" \"package.json\"",
    "format:check": "prettier --check \".vscode/**/*.json\" \".prettierrc.json\" \"eslint.config.mjs\" \"stylelint.config.mjs\" \"playwright.config.ts\" \"tests/**/*.ts\" \"package.json\"",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "preview:static": "node scripts/build_static.js && node scripts/serve_static.js",
    "test:playwright": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:phase1": "tsc -p tsconfig.json --noEmit",
    "test:phase2": "tsc -p tsconfig.json --noEmit",
    "test:phase3": "tsc -p tsconfig.json --noEmit",
    "test:phase4": "tsc -p tsconfig.json --noEmit",
    "test:phase5": "tsc -p tsconfig.json --noEmit",
    "test:visual": "node scripts/visual_smoke.js",
    "test:mirrors": "node scripts/check_dashboard_mirror_drift.js",
    "test:csp": "node scripts/check_csp_hashes.js",
    "test:api": "python scripts/check_api_imports.py",
    "test:security-boundaries": "python scripts/test_security_boundaries.py",
    "test:schedule-iq": "python scripts/test_schedule_iq_validation.py",
    "test:data-health": "python scripts/test_data_health.py",
    "test:trade-quality": "python scripts/test_trade_quality_static.py",
    "test:score-calibration": "python scripts/test_score_calibration.py",
    "agent:audit": "python scripts/run_agent_audit.py",
    "agent:health": "python scripts/daily_league_intelligence_health.py",
    "agent:site-currency": "python scripts/site_currency_agent.py",
    "agent:site-currency:ci": "python scripts/site_currency_agent.py --ci --max-attempts 3",
    "agent:site-currency:collaborator": "python scripts/site_currency_peer_agent.py --role collaborator",
    "agent:site-currency:verifier-data": "python scripts/site_currency_peer_agent.py --role verifier-data",
    "agent:site-currency:verifier-flow": "python scripts/site_currency_peer_agent.py --role verifier-flow",
    "predeploy": "npm run typecheck && npm run test:api && npm run test:security-boundaries && npm run test:schedule-iq && npm run test:data-health && npm run test:trade-quality && npm run test:score-calibration && npm run test:mirrors && npm run test:csp && npm run build",
    "test:readiness": "python scripts/check_product_readiness.py",
    "test:production-readiness": "python scripts/check_product_readiness.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
